    "test": "node --test test/",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michal-skoula/bitwarden-agent-keychain.git"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/michal-skoula/bitwarden-agent-keychain/issues"
  },
  "homepage": "https://github.com/michal-skoula/bitwarden-agent-keychain#readme",
  "dependencies": {
    "@bitwarden/cli": "^2026.10.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.65.1",
    "tldts": "^7.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.85",
    "@types/node": "^26.6.6",
